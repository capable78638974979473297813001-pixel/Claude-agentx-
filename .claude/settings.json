{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/skillforge.py\" banner"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python3 tools/skillforge.py:*)",
      "Bash(python3 -m unittest:*)",
      "Bash(python3 -m pytest:*)"
    ]
  }
}
